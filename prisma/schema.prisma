generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  ADMIN
}

enum AttendanceStatus {
  NOT_STARTED
  WORKING
  DONE
  MISSING
}

enum LeaveType {
  FULL_DAY
  HALF_DAY_AM
  HALF_DAY_PM
}

enum LeaveStatus {
  REQUESTED
  APPROVED
  REJECTED
}

model Member {
  id        Int       @id @default(autoincrement())
  name      String
  email     String?   @unique
  slackId   String    @unique @map("slack_id")
  position  String?
  role      Role      @default(EMPLOYEE)
  createdAt DateTime  @default(now())  @map("created_at")
  updatedAt DateTime  @updatedAt       @map("updated_at")
  deletedAt DateTime?                  @map("deleted_at")

  attendances    Attendance[]
  leaveRequests  LeaveRequest[] @relation("Requester")
  approvedLeaves LeaveRequest[] @relation("Approver")
  leaveBalance   LeaveBalance?
  loginCodes     LoginCode[]

  @@index([slackId])
  @@index([email])
  @@map("members")
}

model Attendance {
  id              Int              @id @default(autoincrement())
  memberId        Int              @map("member_id")
  workDate        DateTime         @db.Date @map("work_date")
  clockInAt       DateTime?        @map("clock_in_at")
  clockOutAt      DateTime?        @map("clock_out_at")
  workedMinutes   Int              @default(0) @map("worked_minutes")
  overtimeMinutes Int              @default(0) @map("overtime_minutes")
  status          AttendanceStatus @default(NOT_STARTED)
  createdAt       DateTime         @default(now())  @map("created_at")
  updatedAt       DateTime         @updatedAt       @map("updated_at")
  deletedAt       DateTime?                         @map("deleted_at")

  member   Member              @relation(fields: [memberId], references: [id])
  sessions AttendanceSession[]

  @@unique([memberId, workDate])
  @@index([workDate])
  @@map("attendances")
}

model AttendanceSession {
  id           Int       @id @default(autoincrement())
  attendanceId Int       @map("attendance_id")
  startAt      DateTime  @map("start_at")
  endAt        DateTime? @map("end_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt      @map("updated_at")
  deletedAt    DateTime?                  @map("deleted_at")

  attendance Attendance @relation(fields: [attendanceId], references: [id])

  @@index([attendanceId])
  @@map("attendance_sessions")
}

model LeaveRequest {
  id         Int         @id @default(autoincrement())
  memberId   Int         @map("member_id")
  type       LeaveType
  startDate  DateTime    @db.Date @map("start_date")
  endDate    DateTime    @db.Date @map("end_date")
  days       Decimal     @db.Decimal(4, 1)
  status     LeaveStatus @default(REQUESTED)
  approverId Int?        @map("approver_id")
  reason     String?
  createdAt  DateTime    @default(now())  @map("created_at")
  updatedAt  DateTime    @updatedAt       @map("updated_at")
  deletedAt  DateTime?                    @map("deleted_at")

  member   Member  @relation("Requester", fields: [memberId], references: [id])
  approver Member? @relation("Approver", fields: [approverId], references: [id])

  @@index([memberId, status])
  @@index([startDate, endDate])
  @@map("leave_requests")
}

model LeaveBalance {
  id        Int       @id @default(autoincrement())
  memberId  Int       @unique @map("member_id")
  totalDays Decimal   @db.Decimal(5, 1) @default(0) @map("total_days")
  usedDays  Decimal   @db.Decimal(5, 1) @default(0) @map("used_days")
  createdAt DateTime  @default(now())  @map("created_at")
  updatedAt DateTime  @updatedAt       @map("updated_at")
  deletedAt DateTime?                  @map("deleted_at")

  member Member @relation(fields: [memberId], references: [id])

  @@map("leave_balances")
}

model LoginCode {
  id        Int       @id @default(autoincrement())
  memberId  Int       @map("member_id")
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())  @map("created_at")
  updatedAt DateTime  @updatedAt       @map("updated_at")
  deletedAt DateTime?                  @map("deleted_at")

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId, expiresAt])
  @@map("login_codes")
}

model AuditLog {
  id        Int       @id @default(autoincrement())
  actorId   Int?      @map("actor_id")
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime  @default(now())  @map("created_at")
  updatedAt DateTime  @updatedAt       @map("updated_at")
  deletedAt DateTime?                  @map("deleted_at")

  @@index([action, createdAt])
  @@map("audit_logs")
}
