generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  ADMIN
}

enum AttendanceStatus {
  NOT_STARTED
  WORKING
  ON_BREAK
  DONE
  MISSING
}

enum LeaveType {
  FULL_DAY
  HALF_DAY_AM
  HALF_DAY_PM
}

enum BreakKind {
  BREAK
  LUNCH
}

enum LeaveStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceEditStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum MeetingType {
  INTERNAL
  EXTERNAL
}

enum RoomBookingStatus {
  CONFIRMED
  CANCELLED
}

model Member {
  id                   Int       @id @default(autoincrement())
  name                 String
  email                String?   @unique
  slackId              String    @unique @map("slack_id")
  position             String?
  role                 Role      @default(EMPLOYEE)
  excludeMissingNotify Boolean   @default(false) @map("exclude_missing_notify")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  attendances      Attendance[]
  leaveRequests    LeaveRequest[]          @relation("Requester")
  approvedLeaves   LeaveRequest[]          @relation("Approver")
  attEditRequests  AttendanceEditRequest[] @relation("AttEditRequester")
  approvedAttEdits AttendanceEditRequest[] @relation("AttEditApprover")
  leaveBalance     LeaveBalance?
  loginCodes       LoginCode[]

  roomBookings         RoomBooking[]         @relation("RoomBookingOrganizer")
  roomBookingAttendees RoomBookingAttendee[] @relation("RoomBookingAttendee")
  roomBookingReminders RoomBookingReminder[] @relation("RoomBookingReminder")

  @@index([slackId])
  @@index([email])
  @@map("members")
}

model Attendance {
  id                     Int              @id @default(autoincrement())
  memberId               Int              @map("member_id")
  workDate               DateTime         @map("work_date") @db.Date
  clockInAt              DateTime?        @map("clock_in_at")
  clockOutAt             DateTime?        @map("clock_out_at")
  workedMinutes          Int              @default(0) @map("worked_minutes")
  breakMinutes           Int              @default(0) @map("break_minutes")
  overtimeMinutes        Int              @default(0) @map("overtime_minutes")
  status                 AttendanceStatus @default(NOT_STARTED)
  clockInReminderSentAt  DateTime?        @map("clock_in_reminder_sent_at")
  clockOutReminderSentAt DateTime?        @map("clock_out_reminder_sent_at")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")
  deletedAt              DateTime?        @map("deleted_at")

  member   Member              @relation(fields: [memberId], references: [id])
  sessions AttendanceSession[]
  breaks   AttendanceBreak[]

  @@unique([memberId, workDate])
  @@index([workDate])
  @@map("attendances")
}

model AttendanceSession {
  id           Int       @id @default(autoincrement())
  attendanceId Int       @map("attendance_id")
  startAt      DateTime  @map("start_at")
  endAt        DateTime? @map("end_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  attendance   Attendance              @relation(fields: [attendanceId], references: [id])
  breaks       AttendanceBreak[]
  editRequests AttendanceEditRequest[]

  @@index([attendanceId])
  // A partial unique, written as raw SQL because the Prisma DSL cannot express one:
  //   CREATE UNIQUE INDEX attendance_sessions_open_unique
  //     ON attendance_sessions (attendance_id)
  //    WHERE end_at IS NULL AND deleted_at IS NULL;
  // → migration 20260422020000_attendance_session_open_unique
  @@map("attendance_sessions")
}

model AttendanceBreak {
  id                  Int       @id @default(autoincrement())
  attendanceId        Int       @map("attendance_id")
  sessionId           Int       @map("session_id")
  startAt             DateTime  @map("start_at")
  endAt               DateTime? @map("end_at")
  kind                BreakKind @default(BREAK)
  lunchReminderSentAt DateTime? @map("lunch_reminder_sent_at")
  // Meals only: the id of the return notice scheduled in Slack for when the meal ends.
  // If the meal is cut short, by leaving early for instance, this is what cancels it.
  // The channel column holds the channel from the scheduling response, always an id.
  // (SLACK_OFFON_CHANNEL may be a name such as '#offon', but cancelling requires an id.)
  autoBackMessageId   String?   @map("auto_back_message_id")
  autoBackChannelId   String?   @map("auto_back_channel_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  attendance Attendance        @relation(fields: [attendanceId], references: [id])
  session    AttendanceSession @relation(fields: [sessionId], references: [id])

  @@index([attendanceId])
  @@index([sessionId])
  // A partial unique, written as raw SQL because the Prisma DSL cannot express one:
  //   CREATE UNIQUE INDEX attendance_breaks_open_unique
  //     ON attendance_breaks (session_id)
  //    WHERE end_at IS NULL AND deleted_at IS NULL;
  // → migration 20260424120200_attendance_breaks_open_unique
  @@map("attendance_breaks")
}

model LeaveRequest {
  id         Int         @id @default(autoincrement())
  memberId   Int         @map("member_id")
  type       LeaveType
  startDate  DateTime    @map("start_date") @db.Date
  endDate    DateTime    @map("end_date") @db.Date
  days       Decimal     @db.Decimal(4, 1)
  status     LeaveStatus @default(REQUESTED)
  approverId Int?        @map("approver_id")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  deletedAt  DateTime?   @map("deleted_at")

  member   Member  @relation("Requester", fields: [memberId], references: [id])
  approver Member? @relation("Approver", fields: [approverId], references: [id])

  @@index([memberId, status])
  @@index([startDate, endDate])
  @@map("leave_requests")
}

model AttendanceEditRequest {
  id           Int                  @id @default(autoincrement())
  memberId     Int                  @map("member_id")
  sessionId    Int                  @map("session_id")
  attendanceId Int                  @map("attendance_id")
  approverId   Int?                 @map("approver_id")
  status       AttendanceEditStatus @default(REQUESTED)
  reason       String?
  rejectReason String?              @map("reject_reason")
  // {startAt, endAt, breaks:[...]} as UTC ISO strings. The snapshot is how it looked at request time; the proposal is what was asked for.
  snapshot     Json
  proposed     Json
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  deletedAt    DateTime?            @map("deleted_at")

  member   Member            @relation("AttEditRequester", fields: [memberId], references: [id])
  approver Member?           @relation("AttEditApprover", fields: [approverId], references: [id])
  session  AttendanceSession @relation(fields: [sessionId], references: [id])

  @@index([memberId, status])
  @@index([status])
  // A partial unique, raw SQL since the DSL cannot express one: at most one pending request per session
  //   CREATE UNIQUE INDEX attendance_edit_requests_pending_unique
  //     ON attendance_edit_requests (session_id)
  //    WHERE status = 'REQUESTED' AND deleted_at IS NULL;
  // → migration 20260520010000_attendance_edit_pending_unique
  @@map("attendance_edit_requests")
}

model LeaveBalance {
  id           Int       @id @default(autoincrement())
  memberId     Int       @unique @map("member_id")
  baseDays     Decimal   @default(0) @map("base_days") @db.Decimal(5, 1)
  bonusDays    Decimal   @default(0) @map("bonus_days") @db.Decimal(5, 1)
  usedDays     Decimal   @default(0) @map("used_days") @db.Decimal(5, 1)
  rolloverYear Int       @map("rollover_year")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  member Member @relation(fields: [memberId], references: [id])

  @@map("leave_balances")
}

model LoginCode {
  id        Int       @id @default(autoincrement())
  memberId  Int       @unique @map("member_id")
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  attempts  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  member Member @relation(fields: [memberId], references: [id])

  @@map("login_codes")
}

model Holiday {
  id        Int       @id @default(autoincrement())
  date      DateTime  @unique @db.Date
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([date])
  @@map("holidays")
}

model AppSetting {
  id                           Int      @id @default(1)
  missingClockInNotifyEnabled  Boolean  @default(false) @map("missing_clockin_notify_enabled")
  missingClockOutNotifyEnabled Boolean  @default(false) @map("missing_clockout_notify_enabled")
  lunchReminderNotifyEnabled   Boolean  @default(false) @map("lunch_reminder_notify_enabled")
  /// The bookable window for rooms, in minutes from midnight. Defaults to 08:00-19:00.
  roomOpenMinutes              Int      @default(480) @map("room_open_minutes")
  roomCloseMinutes             Int      @default(1140) @map("room_close_minutes")
  /// The fixed meal length in minutes. Applies to meals started from now on and leaves the past alone.
  mealMinutes                  Int      @default(60) @map("meal_minutes")
  updatedAt                    DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model MeetingRoom {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  bookings RoomBooking[]

  @@map("meeting_rooms")
}

model RoomBooking {
  id                Int               @id @default(autoincrement())
  roomId            Int               @map("room_id")
  memberId          Int               @map("member_id")
  type              MeetingType
  /// Why the room was booked. What is typed here becomes the calendar event's title.
  title             String
  startAt           DateTime          @map("start_at")
  endAt             DateTime          @map("end_at")
  /// External attendees, as typed. They are not members, so there is nothing to key against.
  externalAttendees String?           @map("external_attendees")
  /// Cancelling flips the status rather than deleting the row, as leave does. Only confirmed bookings count for overlaps.
  status            RoomBookingStatus @default(CONFIRMED)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  deletedAt         DateTime?         @map("deleted_at")

  room      MeetingRoom           @relation(fields: [roomId], references: [id])
  member    Member                @relation("RoomBookingOrganizer", fields: [memberId], references: [id])
  attendees RoomBookingAttendee[]
  reminders RoomBookingReminder[]

  @@index([roomId, startAt])
  @@index([memberId, startAt])
  @@map("room_bookings")
}

model RoomBookingAttendee {
  id        Int      @id @default(autoincrement())
  bookingId Int      @map("booking_id")
  memberId  Int      @map("member_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  booking RoomBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  member  Member      @relation("RoomBookingAttendee", fields: [memberId], references: [id])

  // A pure link row, so there is no soft delete. An edit rewrites the set wholesale, and
  // the parent booking's status owns the lifetime.
  @@unique([bookingId, memberId])
  @@index([memberId])
  @@map("room_booking_attendees")
}

model RoomBookingReminder {
  id                 Int      @id @default(autoincrement())
  bookingId          Int      @map("booking_id")
  memberId           Int      @map("member_id")
  /// The Slack DM channel id, passed straight to the cancel call.
  channelId          String   @map("channel_id")
  /// The scheduled message id Slack returned.
  scheduledMessageId String   @map("scheduled_message_id")
  /// When it is due to be sent, shortly before the meeting. Kept for diagnosis and recomputation.
  postAt             DateTime @map("post_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  booking RoomBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  member  Member      @relation("RoomBookingReminder", fields: [memberId], references: [id])

  // A link row, so there is no soft delete. When a booking changes, these are torn down and set again.
  @@unique([bookingId, memberId])
  @@index([bookingId])
  @@map("room_booking_reminders")
}

model AuditLog {
  id        Int       @id @default(autoincrement())
  actorId   Int?      @map("actor_id")
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([action, createdAt])
  @@map("audit_logs")
}
