# Copy this file to .env.local and fill in the values.
#
#   cp .env.example .env.local
#
# Generate the two secrets below with:  openssl rand -base64 32

# --- Database (required) ---
# URL-encode special characters in the password (e.g. ! # @ -> %21 %23 %40).
# Local Docker Postgres (pnpm db:local:up) uses exactly this URL:
DATABASE_URL="postgresql://offon:offon@localhost:55432/offon?schema=public"
# A hosted Postgres looks like this instead:
# DATABASE_URL="postgresql://user:password@host:5432/offon?sslmode=require&schema=public"

# --- Auth (required) ---
SESSION_SECRET=""                     # signs the session JWT; rotating it logs everyone out
OTP_PEPPER=""                         # extra secret mixed into login codes before hashing

# --- Slack (required) ---
# See docs/slack-app.md for how to create the app and obtain these.
SLACK_BOT_TOKEN="xoxb-"               # Bot User OAuth Token; scopes: chat:write, im:write, commands
SLACK_SIGNING_SECRET=""               # verifies inbound slash-command requests really came from Slack
SLACK_OFFON_CHANNEL="C"               # channel ID for clock-event announcements; invite the bot to it

# --- Cron (required in production) ---
CRON_SECRET=""                        # scheduled jobs send `Authorization: Bearer <CRON_SECRET>`

# --- Initial admin seed (only read by `pnpm db:seed`) ---
SEED_ADMIN_NAME="Ada Lovelace"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_SLACK_ID="U"               # this person's Slack member ID; their login code is DM'd here
SEED_ADMIN_TOTAL_DAYS="15"            # starting annual-leave balance, in days
